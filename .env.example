# ============================================================================
# Laras Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
# Sections:
#   1. Required — app will not start without these
#   2. Database — Turso/libSQL (production) or local SQLite (development)
#   3. Authentication — JWT signing secret
#   4. AI Provider — DeepSeek API (content generation)
#   5. Supabase Storage — file uploads (optional for dev)
#   6. Owner Bootstrap — CLI-only first-owner setup
#   7. Deployment — production environment
# ============================================================================

# ============================================================================
# 1. REQUIRED — App will not start without these
# ============================================================================

# Database connection string.
# - Development: file:./db/laras.db (local SQLite, no external deps)
# - Production:  libsql://<host>.turso.io (see Database section below)
DATABASE_URL="file:./db/laras.db"

# JWT signing secret for session tokens, CSRF, and appeal tokens.
# Generate with: openssl rand -base64 32
# Minimum 32 characters. Keep this secret.
AUTH_SECRET="dev-auth-secret-do-not-use-in-production-32bytes"

# ============================================================================
# 2. DATABASE — Turso/libSQL (production only, optional for dev)
# ============================================================================
# When DATABASE_URL starts with libsql://, the libSQL adapter is used.
# TURSO_AUTH_TOKEN is required only when using Turso.
# For local development, use DATABASE_URL=file:./db/laras.db and skip these.

# TURSO_DATABASE_URL="libsql://<your-db>.turso.io"
# TURSO_AUTH_TOKEN="<turso-auth-token>"

# ============================================================================
# 3. AUTHENTICATION
# ============================================================================
# AUTH_SECRET is already covered in Required section above.
# No additional auth variables needed — Laras uses JWT with jose, no OAuth providers.

# ============================================================================
# 4. AI PROVIDER — DeepSeek API
# ============================================================================
# Required for: CV generation, cover letters, professional bio, essays,
#               interview question generation & feedback, English practice
#               (reading, structure, listening), opportunity analysis,
#               document summarization and revision.
#
# When missing: AI features return safe errors. Non-AI workflows work normally.
# Get a key: https://platform.deepseek.com/

DEEPSEEK_API_KEY=

# Optional — override the default base URL. Default is https://api.deepseek.com
# DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ============================================================================
# 5. SUPABASE STORAGE — File uploads (optional for dev)
# ============================================================================
# Required for: profile photos, document exports (PDF, PPTX, DOCX),
#               listening audio storage, deck exports.
#
# When missing: uploads fail gracefully. Local /public/audio/ is used for
#               listening audio in dev mode.
#
# Buckets needed: listening-audio (public), generated-documents (private),
#                 user-exports (private), deck-exports (private),
#                 pdf-exports (private), profile-photos (private).

# Supabase project URL (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Browser/client-side key (safe to expose — used for public bucket reads)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Alternative name for the publishable key (only one needed)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side secret key (NEVER exposed to browser — used for private uploads)
SUPABASE_SECRET_KEY=

# Alternative name for the service role key (only one needed)
# SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# 6. OWNER BOOTSTRAP — CLI-only first-owner setup
# ============================================================================
# Used by: bun run bootstrap:owner
# This is a CLI script, NOT an HTTP endpoint.
# Only needed once to promote the first user to "owner" role.
#
# Usage:
#   BOOTSTRAP_SECRET=<secure-random-string> OWNER_EMAIL=<email> bun run bootstrap:owner
#
# Requirements:
#   - BOOTSTRAP_SECRET must be ≥ 32 characters
#   - BOOTSTRAP_SECRET must NOT equal AUTH_SECRET
#   - OWNER_EMAIL must match an existing registered account

# BOOTSTRAP_SECRET=
# OWNER_EMAIL=

# ============================================================================
# 7. DEPLOYMENT
# ============================================================================

# NODE_ENV is set automatically by Next.js (development | production | test).
# Do not set it manually in .env unless you have a specific reason.
# NODE_ENV=production
# Trusted private beta access. In production, beta mode defaults to enabled
# unless explicitly disabled. Use a comma-separated email allowlist.
PRIVATE_BETA_MODE="true"
PRIVATE_BETA_EMAILS="tester@example.com"
# Set false for quiet local test runs; query logging is otherwise enabled in development.
PRISMA_QUERY_LOG="true"
