# Laras — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env. NEVER paste real secret values here.

# ── Database — Turso/libSQL ──────────────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# DATABASE_URL is used by Prisma; point it at the same Turso libSQL URL.
DATABASE_URL=

# ── App auth ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Supabase Storage (for file uploads) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI SDK ───────────────────────────────────────────────
ZAI_API_KEY=

# ── Git push (optional, only for CI/automation) ──────────
# GITHUB_TOKEN=
