# Laras environment template — copy to .env and fill in real values.
# NEVER commit the real .env file. Only this .env.example is tracked.

# Turso/libSQL production database
DATABASE_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# App auth (HS256 signing secret for session JWTs — generate a long random string)
AUTH_SECRET=

# Supabase Storage (optional — only needed for file upload/storage features)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI SDK (optional — z-ai-web-dev-sdk may auto-resolve in some environments)
ZAI_API_KEY=
