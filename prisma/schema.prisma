// Laras — Career & Opportunity Readiness Ecosystem
// Data model: one UserProfile as the single source of truth (Brief Section 4).
// Designed to mirror a future Supabase/Postgres migration (supabase/migrations/0001_init.sql).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (local dev). In production this maps to Supabase Auth (auth.users).
// ---------------------------------------------------------------------------
model Account {
  id                    String       @id @default(cuid())
  email                 String       @unique
  passwordHash          String
  name                  String?
  role                  String       @default("user") // user | moderator | admin | owner (canonical 4-role model, Phase 1D)
  suspended             Boolean      @default(false)
  suspendedAt           DateTime?
  suspensionReason      String?
  mfaEnabled            Boolean      @default(false)
  mfaSecret             String?      // TOTP secret (encrypted at rest in production)
  sessionVersion        Int          @default(0)    // Incremented to revoke all sessions
  refreshTokenVersion   Int          @default(0)    // Incremented to revoke refresh tokens
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  profile               UserProfile?

  scopedAssignments        ScopedAssignment[]
  grantedScopedAssignments ScopedAssignment[] @relation("GrantedScopedAssignments")
}

// ---------------------------------------------------------------------------
// UserProfile — the single source of truth shared by all 5 verticals.
// ---------------------------------------------------------------------------
model UserProfile {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // --- Profil dasar (Section 4) ---
  fullName   String?
  headline   String?
  summary    String? // ringkasan profesional mentah dari user
  email      String?
  phone      String?
  location   String?
  photoUrl   String?
  links      String? // JSON: { linkedin?, portfolio?, github?, website?, other? }

  // --- Preferensi & locale (Section 9) ---
  uiLocale        String  @default("id") // "id" | "en" — bahasa antarmuka
  docLocale       String  @default("id") // bahasa dokumen (independen dari UI)
  targetRegion    String  @default("domestic") // "domestic" | "international"
  opportunityTypes String? // JSON array: ["work","org","scholarship","volunteer"]
  preferredTone   String? // "formal" | "direct" | "warm" | "confident"

  // --- Onboarding (Section 4.1) ---
  onboardingComplete Boolean @default(false)
  onboardingStep     Int     @default(0)
  profileCompletion  Int     @default(0)
  targetExamScore    String? // e.g. TOEFL target — module-specific field lives here
  urgency            String? // "deadline-soon" | "exploring" | "active"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences    Experience[]
  educations     Education[]
  skills         Skill[]
  certifications Certification[]
  languages      LanguageProficiency[]
  applications   Application[]
  documents      Document[]
  interviewSets  InterviewSet[]
  essays         Essay[]
  englishSessions EnglishSession[]
  certificates   EnglishCertificate[]
  achievements   Achievement[]
  evidences      Evidence[]
  activityEvents ActivityEvent[]
  notifications  Notification[]
  opportunities  Opportunity[]
  announcementsRead AnnouncementRead[]
  quotaEntries    QuotaLedger[]
  auditLogs      AuditLog[]
  verificationBadges VerificationBadge[]
  licenses       License[]
  consentSettings ConsentSetting[]
  connectionsOutgoing Connection[] @relation("ConnectionRequester")
  connectionsIncoming Connection[] @relation("ConnectionAddressee")
  reports            Report[]       @relation("ReporterReports")
  conversationParticipants ConversationParticipant[]
  sentMessages              Message[]
  sentMessageRequests       MessageRequest[] @relation("MessageRequestSender")
  receivedMessageRequests   MessageRequest[] @relation("MessageRequestRecipient")
  blockedUsers              Block[]          @relation("BlockBlocker")
  blockedBy                 Block[]          @relation("BlockBlocked")
  organizationMemberships   OrganizationMembership[]
  circleMemberships         CircleMembership[]
  campaignMemberships       CampaignMember[]
  mentorshipProfile         MentorshipProfile?
  mentorshipRequestsAsMentor MentorshipRequest[] @relation("MentorshipMentor")
  mentorshipRequestsAsMentee MentorshipRequest[] @relation("MentorshipMentee")
}

// --- Riwayat pengalaman (Section 4) — contextNotes is the anti-generic foundation ---
model Experience {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  type          String      @default("work") // work | org | project | volunteer
  title         String
  organization  String
  startDate     String? // "2023-01"
  endDate       String? // "2024-05" or "Present"
  current       Boolean     @default(false)
  location      String?
  description   String?
  achievements  String? // JSON string[] — bullet points
  contextNotes  String? // CRITICAL: project names, clients, challenges, real numbers
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  evidences     Evidence[]

  @@index([userProfileId])
}

model Education {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  institution   String
  degree        String?
  field         String?
  startDate     String?
  endDate       String?
  current       Boolean     @default(false)
  gpa           String?
  description   String?
  order         Int         @default(0)

  @@index([userProfileId])
}

model Skill {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  name          String
  category      String? // technical | soft | tool | language | domain
  proficiency   String? // beginner | intermediate | advanced | expert
  context       String? // WHERE used — anti-generic (Section 5)
  order         Int         @default(0)

  evidences     Evidence[]

  @@index([userProfileId])
}

model Certification {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  name          String
  issuer        String?
  issueDate     String?
  expiryDate    String?
  credentialId  String?
  url           String?
  order         Int         @default(0)

  @@index([userProfileId])
}

model LanguageProficiency {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  language      String
  level         String? // native | fluent | advanced | intermediate | beginner | CEFR A1-C2
  order         Int         @default(0)

  @@index([userProfileId])
}

// ---------------------------------------------------------------------------
// Vertical 2.2 — Application Ops (job & opportunity tracker)
// ---------------------------------------------------------------------------
model Application {
  id             String      @id @default(cuid())
  userProfileId  String
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  type           String      @default("work") // work | org | scholarship | volunteer
  position       String
  organization   String?
  status         String      @default("saved") // saved | applied | interview | offer | rejected | accepted
  deadline       String?
  location       String?
  url            String?
  jobDescription String? // pasted listing
  summary        String? // AI-extracted: requirements, deadline, contacts
  notes          String?
  order          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  documents      ApplicationDocument[]

  @@index([userProfileId])
}

model Document {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  type          String // cv-ats | cv-visual | cover-letter | bio | deck | essay
  title         String
  content       String? // JSON: document structure / generated text
  config        String? // JSON: GenerationConfig snapshot
  fileUrl       String? // exported file path/URL
  version       Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  applications  ApplicationDocument[]
  versions      DocumentVersion[]
  revisions     RevisionRequest[]

  @@index([userProfileId])
}

// Document versioning — each revision creates a new version (Brief Task 2)
model DocumentVersion {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String   // JSON: full content snapshot
  configSnapshot String  // JSON: GenerationConfig used for this version
  revisionInstruction String? // what the user asked for (null = initial generation)
  parentVersionId String? // link to previous version
  createdAt     DateTime @default(now())

  @@index([documentId])
}

// Revision requests — user instructions for follow-up changes (Brief Task 2)
model RevisionRequest {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  instruction   String   // e.g. "shorten", "more formal", "add experience X"
  status        String   @default("pending") // pending | completed | failed
  resultVersionId String? // resulting DocumentVersion id
  createdAt     DateTime @default(now())

  @@index([documentId])
}

model ApplicationDocument {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sentAt        DateTime?
  note          String?
  createdAt     DateTime    @default(now())
}

// ---------------------------------------------------------------------------
// Vertical 2.3 — Interview & Selection Prep
// ---------------------------------------------------------------------------
model InterviewSet {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  title         String
  role          String? // target role/org/scholarship
  context       String? // pasted job desc or org info
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  questions     InterviewQuestion[]

  @@index([userProfileId])
}

model InterviewQuestion {
  id             String       @id @default(cuid())
  interviewSetId String
  interviewSet   InterviewSet @relation(fields: [interviewSetId], references: [id], onDelete: Cascade)
  question       String
  category       String? // behavioral | technical | motivational | situational
  suggestedAnswer String? // AI-suggested, grounded in real experiences
  userAnswer     String? // user's drafted answer
  feedback       String? // JSON: { structure, specificity, length, fillerWords }
  order          Int          @default(0)

  @@index([interviewSetId])
}

// ---------------------------------------------------------------------------
// Vertical 2.5 — Opportunity Essays & Statements
// ---------------------------------------------------------------------------
model Essay {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  type          String // scholarship | org | volunteer | personal-statement | motivation-letter
  title         String
  prompt        String? // the essay question / requirements
  targetOrg     String?
  wordLimit     Int?
  draft         String? // generated essay text
  probingQA     String? // JSON: [{q,a}] — Section 5.4 strict verification Q&A
  concretenessScore Int? // 0-100 (Section 5.5)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userProfileId])
}

// ---------------------------------------------------------------------------
// Vertical 2.4 — English & Communication Readiness (Reading/Structure on-the-go)
// ---------------------------------------------------------------------------
model EnglishSession {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  module        String // reading | structure | listening
  passage       String? // text or script
  questions     String? // JSON array of {q, options, answer, explanation}
  audioUrl      String? // for listening — path to pre-generated audio file (Brief 10.3 play-time)
  userAnswers   String? // JSON array of selected indices
  score         Int?
  createdAt     DateTime    @default(now())

  @@index([userProfileId])
}

// Listening question bank — PRE-GENERATED during development (Brief Section 10.3).
// Generation-time: script → TTS → audio file → row here with audioUrl filled.
// Play-time: user gets a random row where audioUrl IS NOT NULL — never triggers TTS.
// Questions without audioUrl are "drafts" not yet published to users.
model ListeningQuestion {
  id          String   @id @default(cuid())
  title       String
  script      String   // the listening script text
  speaker     String   // description: "Conversation between two students" etc.
  questions   String   // JSON array of {id, question, options, answer, explanation}
  difficulty  String   @default("medium") // easy | medium | hard
  topic       String   // scenario topic
  audioUrl    String?  // path to pre-generated MP3 — NULL means not yet generated (draft, not published)
  published   Boolean  @default(false) // only published=true questions are shown to users
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// English Practice Certificate (non-official) — Brief: Practice Certificate
model EnglishCertificate {
  id                String   @id @default(cuid())
  userProfileId     String
  userProfile       UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  sessionId         String?  // linked EnglishSession
  certificateId     String   @unique // public verification ID
  title             String   // "Laras Practice Score Certificate"
  testMode          String   // reading | listening | structure
  testSpec          String   // LARAS_TOEFL_STYLE | LARAS_IELTS_STYLE
  rawScore          Int
  percentage        Int
  estimatedCEFR     String?
  estimatedTOEFL    String?  // "4.5" (1-6 scale)
  estimatedIELTS    String?  // "7.0" (0-9 band)
  confidence        String   // low | medium | high
  skillBreakdown    String   // JSON
  questionCount     Int
  disclaimerText    String
  pdfStoragePath    String?  // Supabase Storage path
  pdfUrl            String?  // signed URL or public URL
  status            String   @default("active") // active | revoked
  issuedAt          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userProfileId])
}

// ---------------------------------------------------------------------------
// Achievement — gamification badges earned by user (Brief: Achievement system)
// ---------------------------------------------------------------------------
model Achievement {
  id            String   @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  code          String   // stable code: "first_cv", "first_cover_letter", "practice_streak_7", etc.
  title         String
  description   String
  icon          String   // lucide icon name: "FileText", "Award", "Flame", etc.
  tone          String   @default("primary") // primary | success | warning | info
  earnedAt      DateTime @default(now())

  evidences     Evidence[]

  @@unique([userProfileId, code]) // one badge per user per code
  @@index([userProfileId])
}

// ---------------------------------------------------------------------------
// Evidence — Evidence Graph (Phase 2A, Brief §9.1)
// Structured proof linked to profile elements: projects, metrics, artifacts.
// Provenance-aware: self-reported by default, verifiable in future phases.
// ---------------------------------------------------------------------------
model Evidence {
  id            String   @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  type          String   @default("project") // project | metric | artifact | certification | publication | other
  title         String
  description   String?
  sourceUrl     String?  // URL to proof artifact (GitHub, portfolio, publication, etc.)
  metricValue   String?  // "30% increase", "200 users", "Rp 50M saved"
  metricContext String?  // how the metric was measured, over what period, with what baseline
  verificationStatus String @default("self-reported") // self-reported | pending | verified | disputed
  verifiedBy    String?  // Account.id of verifier (future phase)
  verifiedAt    DateTime?
  experienceId  String?  // optional link to Experience
  experience    Experience? @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  skillId       String?  // optional link to Skill
  skill         Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)
  achievementId String?  // optional link to Achievement
  achievement   Achievement? @relation(fields: [achievementId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userProfileId])
  @@index([experienceId])
  @@index([skillId])
  @@index([achievementId])
}

// ---------------------------------------------------------------------------
// ActivityEvent — Durable activity event store (Phase 2B, Brief §9.1)
// Replaces on-the-fly activity computation. Append-only, owner-scoped reads.
// ---------------------------------------------------------------------------
model ActivityEvent {
  id            String   @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  type          String   // document.create | application.create | interview.create | english.complete | profile.update | connection.accept | evidence.create
  resourceType  String?  // "Document", "Application", "InterviewSet", etc.
  resourceId    String?  // ID of the affected resource
  metadata      String?  // JSON: { title, type, summary }
  createdAt     DateTime @default(now())

  @@index([userProfileId, createdAt])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Notification — Durable notification store (Phase 2C, Brief §9.1)
// Replaces per-request count queries. Recipient-scoped, with read state.
// ---------------------------------------------------------------------------
model Notification {
  id            String   @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  type          String   // connection.request | connection.accepted | announcement | system
  title         String
  body          String?
  resourceType  String?  // "Connection", "Announcement", etc.
  resourceId    String?  // ID for deeplinking
  readAt        DateTime? // null = unread
  createdAt     DateTime @default(now())

  @@index([userProfileId, readAt, createdAt])
  @@index([userProfileId, createdAt])
}

// ---------------------------------------------------------------------------
// AuditLog — security & action audit trail (Brief: Production Hardening)
// ---------------------------------------------------------------------------
model AuditLog {
  id            String   @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  action        String   // "auth.login", "document.create", "profile.update", etc.
  resourceType  String?  // "Account", "Document", "Application", etc.
  resourceId    String?  // ID of the affected resource
  metadata      String?  // JSON: additional context (email, ip, changes, etc.)
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([userProfileId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// ReadingQuestion — pre-generated reading practice bank (Brief §10.3)
// Mirrors ListeningQuestion structure but for reading comprehension.
// ---------------------------------------------------------------------------
model ReadingQuestion {
  id          String   @id @default(cuid())
  title       String
  passage     String   // the reading passage text
  difficulty  String   @default("medium") // easy | medium | hard
  topic       String?  // scenario topic: psychology, science, business, etc.
  questions   String   // JSON array of {id, question, options, answer, explanation}
  published   Boolean  @default(false) // only published=true questions are shown to users
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([difficulty, published])
}

// ---------------------------------------------------------------------------
// StructureQuestion — pre-generated grammar/structure practice bank (Brief §10.3)
// Mirrors ListeningQuestion/ReadingQuestion pattern for structure section.
// ---------------------------------------------------------------------------
model StructureQuestion {
  id          String   @id @default(cuid())
  difficulty  String   @default("medium") // easy | medium | hard
  topic       String?  // grammar topic: grammar-mixed, tenses, conditionals, etc.
  questions   String   // JSON array of {id, question, options, answer, explanation, type}
  published   Boolean  @default(false) // only published=true questions are shown to users
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([difficulty, published])
}

// ---------------------------------------------------------------------------
// VerificationBadge — Trust and Verification Graph (Brief §9.1)
// Tracks per-claim verification state: email, phone, skill, education,
// employment, identity. Each badge has a status (pending | verified | rejected
// | expired) and an optional verifiedAt timestamp + verifier note.
// In pre-production, email/phone badges auto-verify on profile completion;
// other types are admin-issuable. This is the foundation for trust signals
// shown on the dashboard and (future) public profile.
// ---------------------------------------------------------------------------
model VerificationBadge {
  id            String   @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  type          String   // email | phone | identity | education | employment | skill
  status        String   @default("pending") // pending | verified | rejected | expired
  verifiedAt    DateTime?
  expiresAt     DateTime? // optional expiry (e.g. annual re-verification)
  evidence      String?  // JSON: { summary, source, referenceId? }
  note          String?  // admin/verifier note
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userProfileId, type]) // one badge per type per user
  @@index([userProfileId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// License — Entitlement & License Engine (Brief §9.4 monetization/entitlement)
// Grants a user access to a plan (free | pro | org) with optional feature
// flags and an expiry. Multiple licenses can exist per user (e.g. a pro trial
// + an org license); the most permissive active one wins at entitlement time.
// ---------------------------------------------------------------------------
model License {
  id            String   @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  plan          String   @default("free") // free | plus | pro | max
  status        String   @default("active") // active | expired | suspended | cancelled
  features      String?  // JSON string[] of feature keys this license grants (overrides plan defaults if set)
  note          String?  // admin note (reason for grant, promo code, etc.)
  issuedById    String?  // Account.id of the admin who issued it (audit trail)
  startsAt      DateTime @default(now())
  expiresAt     DateTime? // null = no expiry
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userProfileId])
  @@index([status])
  @@index([plan])
}

// ---------------------------------------------------------------------------
// ConsentSetting — Consent and Privacy Graph (Brief §9.1)
// Per-field visibility consent for a user's profile. Each trackable field
// (fullName, email, phone, location, links, experiences, education, skills,
// certifications, languages) has a visibility level:
//   public       — visible to anyone (future public profile)
//   connections  — visible only to accepted connections (future network)
//   private      — visible only to the user themselves
// Defaults are conservative (private for contact info, public for professional
// history). Users can change any field's visibility at any time.
// ---------------------------------------------------------------------------
model ConsentSetting {
  id            String   @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  field         String   // fullName | email | phone | location | links | experiences | education | skills | certifications | languages
  visibility    String   @default("private") // public | connections | private
  updatedAt     DateTime @updatedAt

  @@unique([userProfileId, field]) // one setting per field per user
  @@index([userProfileId])
}

// ---------------------------------------------------------------------------
// Connection — Relationship / Network Graph (Brief §9.3)
// Directed connection request between two UserProfile records.
//   requester → addressee, status: pending | accepted | declined | blocked
// One row per pair (unique on [requesterId, addresseeId]).
// When status=accepted, the two users are "connected" and can see each
// other's "connections"-level profile fields (per the Consent/Privacy Graph).
// ---------------------------------------------------------------------------
model Connection {
  id          String   @id @default(cuid())
  requesterId String
  requester   UserProfile @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   UserProfile @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // pending | accepted | declined | blocked
  message     String?  // optional intro message from requester
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId]) // one request per directed pair
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Announcement — Targeted platform communications (Brief §9.4/§9.5)
// Admin-authored announcements shown to users based on audience targeting:
//   all       — every user
//   free      — users on the free plan
//   pro       — users with a pro/org license
//   admin     — admin/owner only
// Priority: low | normal | high | urgent (controls visual prominence).
// Status: draft | published | archived. Only published announcements with
// publishedAt <= now appear in the user feed.
// ---------------------------------------------------------------------------
model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String
  audience    String   @default("all") // all | free | pro | admin
  priority    String   @default("normal") // low | normal | high | urgent
  status      String   @default("draft") // draft | published | archived
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reads       AnnouncementRead[]

  @@index([status, publishedAt])
  @@index([audience])
}

// ---------------------------------------------------------------------------
// AnnouncementRead — tracks which announcements a user has read/dismissed
// (Phase 8C). Prevents announcements from reappearing on every visit.
// ---------------------------------------------------------------------------
model AnnouncementRead {
  id             String   @id @default(cuid())
  userProfileId  String
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  readAt         DateTime @default(now())
  dismissed      Boolean  @default(false)

  @@unique([userProfileId, announcementId])
  @@index([userProfileId])
  @@index([announcementId])
}

// ---------------------------------------------------------------------------
// Opportunity — Opportunity Graph (Phase 3A, Brief §9.1)
// Jobs, internships, scholarships, ODP, BUMN, CPNS, fellowships, competitions,
// volunteering, and events. User-created (saved) or discovered.
// ---------------------------------------------------------------------------
model Opportunity {
  id            String   @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  type          String   @default("job") // job | internship | scholarship | fellowship | competition | volunteer | event | odp | bumn | cpns | other
  title         String
  organization  String?
  description   String?
  requirements  String?  // JSON: { required: [...], preferred: [...], minimumEducation, minimumGPA, maxAge, etc. }
  deadline      String?  // ISO date string
  location      String?
  url           String?  // external listing URL
  source        String   @default("manual") // manual | scraped | imported
  status        String   @default("saved") // saved | applied | interviewing | offered | accepted | rejected | archived | expired
  matchScore    Int?     // 0-100 match against profile (computed)
  matchDetail   String?  // JSON: { strengths: [...], gaps: [...], readiness }
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userProfileId])
  @@index([type])
  @@index([status])
  @@index([deadline])
}

// ---------------------------------------------------------------------------
// QuotaLedger — Atomic entitlement consumption (Phase 3C, Brief §24)
// Replaces stateless count-based caps with idempotent, auditable consumption.
// ---------------------------------------------------------------------------
model QuotaLedger {
  id             String   @id @default(cuid())
  userProfileId  String
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  capability     String   // e.g. "documents.create", "interview.create", "english.generate"
  consumedAt     DateTime @default(now())
  amount         Int      @default(1)
  idempotencyKey String   // client-supplied unique key per operation (scoped to user)
  metadata       String?  // JSON: { resourceType, resourceId }
  refundedAt     DateTime? // non-null means the consumption was refunded

  @@unique([userProfileId, idempotencyKey])
  @@index([userProfileId])
  @@index([capability])
  @@index([consumedAt])
}

// ---------------------------------------------------------------------------
// LicenseCode — Code-based license redemption (Phase 5A, Brief §25)
// Supports individual, batch, and campaign code generation.
// ---------------------------------------------------------------------------
model LicenseCode {
  id              String   @id @default(cuid())
  code            String   @unique // the redemption code (hashed for storage)
  plan            String   // free | plus | pro | max
  features        String?  // JSON string[] of feature keys
  maxRedemptions  Int      @default(1) // 1 = individual, >1 = batch
  currentRedemptions Int   @default(0)
  batchId         String?  // groups codes into batches/campaigns
  campaignId      String?  // links to a campaign for overrides
  campaign        Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdById     String   // Account.id of the admin who created it
  isActive        Boolean  @default(true)
  startsAt        DateTime @default(now())
  expiresAt       DateTime? // optional expiry
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
  @@index([batchId])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// Report — Moderation report system (Phase 4B)
// Users can report content, users, connections, messages, etc.
// ---------------------------------------------------------------------------
model Report {
  id             String   @id @default(cuid())
  reporterId     String   // UserProfile.id who reported
  reporter       UserProfile @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     String   // "user" | "connection" | "message" | "circle" | "mentorship" | "content"
  targetId       String   // ID of the reported entity
  reason         String   // "harassment" | "spam" | "impersonation" | "inappropriate" | "other"
  description    String?
  evidence       String?  // JSON: { urls, screenshots }
  status         String   @default("open") // open | investigating | resolved | dismissed
  priority       String   @default("normal") // low | normal | high | urgent
  assignedToId   String?  // Account.id of moderator
  resolution     String?  // moderator note on resolution
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  moderationCases ModerationCase[]

  @@index([reporterId])
  @@index([status])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// ModerationCase — Moderation actions on users (Phase 4B)
// Warning, suspension, ban, restriction records.
// ---------------------------------------------------------------------------
model ModerationCase {
  id             String   @id @default(cuid())
  reportId       String?
  report         Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  subjectId      String   // Account.id of subject
  type           String   // "warning" | "suspension" | "ban" | "restriction"
  status         String   @default("active") // active | expired | revoked
  reason         String
  moderatorId    String   // Account.id of acting moderator
  duration       String?  // "24h" | "7d" | "30d" | "permanent"
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedById    String?  // Account.id of revoking moderator
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  appeals        Appeal[]

  @@index([subjectId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Appeal — User appeals against moderation actions (Phase 4C)
// ---------------------------------------------------------------------------
model Appeal {
  id             String   @id @default(cuid())
  caseId         String
  moderationCase ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  appellantId    String   // Account.id
  reason         String
  status         String   @default("pending") // pending | reviewed | granted | denied
  reviewerId     String?  // Account.id of reviewer
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([caseId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Permission — Granular capability definitions (Phase 4A)
// Each row defines a single atomic capability.
// ---------------------------------------------------------------------------
model Permission {
  id          String   @id @default(cuid())
  capability  String   @unique // e.g. "users.read", "roles.manage", "moderation.cases"
  description String?
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// RolePermission — Maps canonical roles to capabilities (Phase 4A)
// Default grants per role.  "granted: false" explicitly denies.
// ---------------------------------------------------------------------------
model RolePermission {
  id         String  @id @default(cuid())
  role       String  // owner | admin | moderator | user
  capability String  // references Permission.capability
  granted    Boolean @default(true)

  @@unique([role, capability])
  @@index([role])
}

// ---------------------------------------------------------------------------
// ScopedAssignment — Per-account capability grants with optional scope
// and expiry (Phase 4A).  Checked *before* role-based permissions.
// ---------------------------------------------------------------------------
model ScopedAssignment {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  capability  String
  scope       String?   // e.g. "community:abc123" — restricts to specific resource
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime?
  grantedById String
  grantedBy   Account   @relation("GrantedScopedAssignments", fields: [grantedById], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([capability])
}

// ---------------------------------------------------------------------------
// Campaign — License campaigns and sponsored access (Phase 5B)
// ---------------------------------------------------------------------------
model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  plan        String   // free | plus | pro | max
  features    String?  // JSON string[] of feature keys
  maxSeats    Int      @default(100)
  usedSeats   Int      @default(0)
  startsAt    DateTime @default(now())
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdById String   // Account.id of admin
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  codes       LicenseCode[]
  members     CampaignMember[]

  @@index([isActive])
}

// ---------------------------------------------------------------------------
// CampaignMember — Join table for campaign-user membership (Phase 5B)
// ---------------------------------------------------------------------------
model CampaignMember {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  enrolledAt    DateTime @default(now())
  expiresAt     DateTime?

  @@unique([campaignId, userProfileId])
  @@index([userProfileId])
}

// ---------------------------------------------------------------------------
// FeatureFlag — Dynamic feature flags (Phase 5B)
// ---------------------------------------------------------------------------
model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  description String?
  rules       String?  // JSON: { plans: [...], roles: [...], percentage: 0-100 }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// DynamicConfig — Runtime configuration (Phase 5B)
// ---------------------------------------------------------------------------
model DynamicConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   // JSON-encoded value
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Conversation — Professional messaging (Phase 6A)
// ---------------------------------------------------------------------------
model Conversation {
  id          String   @id @default(cuid())
  title       String?
  type        String   @default("direct") // direct | group
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    Message[]
  participants ConversationParticipant[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userProfileId  String
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime @default(now())

  @@unique([conversationId, userProfileId])
  @@index([userProfileId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         UserProfile @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  editedAt       DateTime?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// MessageRequest — Inbound message requests before acceptance (Phase 6A)
// ---------------------------------------------------------------------------
model MessageRequest {
  id             String   @id @default(cuid())
  senderId       String
  sender         UserProfile @relation("MessageRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId    String
  recipient      UserProfile @relation("MessageRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body           String
  status         String   @default("pending") // pending | accepted | declined
  acceptedAt     DateTime?
  declinedAt     DateTime?
  createdAt      DateTime @default(now())

  @@index([recipientId, status])
  @@index([senderId])
}

// ---------------------------------------------------------------------------
// Block — User blocking (Phase 6A)
// ---------------------------------------------------------------------------
model Block {
  id          String   @id @default(cuid())
  blockerId   String
  blocker     UserProfile @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String
  blocked     UserProfile @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

// ---------------------------------------------------------------------------
// Organization — Institution/Organization workspace (Phase 7A)
// ---------------------------------------------------------------------------
model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  description     String?
  logoUrl         String?
  website         String?
  type            String   @default("institution") // institution | company | community | government
  verificationStatus String @default("unverified") // unverified | pending | verified | rejected
  verifiedAt      DateTime?
  createdById     String   // Account.id of founder
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  memberships     OrganizationMembership[]
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userProfileId  String
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  role           String   @default("member") // owner | admin | member
  joinedAt       DateTime @default(now())

  @@unique([organizationId, userProfileId])
  @@index([userProfileId])
}

// ---------------------------------------------------------------------------
// CareerCircle — Professional communities (Phase 6B)
// ---------------------------------------------------------------------------
model CareerCircle {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String   @default("community") // community | study_group | peer_review
  createdById String   // UserProfile.id
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships CircleMembership[]
}

model CircleMembership {
  id          String   @id @default(cuid())
  circleId    String
  circle      CareerCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userProfileId String
  userProfile UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  role        String   @default("member") // admin | moderator | member
  joinedAt    DateTime @default(now())

  @@unique([circleId, userProfileId])
  @@index([userProfileId])
}

// ---------------------------------------------------------------------------
// MentorshipProfile — Mentorship system (Phase 6C)
// ---------------------------------------------------------------------------
model MentorshipProfile {
  id             String   @id @default(cuid())
  userProfileId  String   @unique
  userProfile    UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  isMentor       Boolean  @default(false)
  isMentee       Boolean  @default(false)
  mentorTopics   String?  // JSON: ["career", "technical", "leadership"]
  menteeGoals    String?  // JSON: [{ goal, timeline }]
  bio            String?
  availability   String?  // "weekly" | "biweekly" | "monthly"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MentorshipRequest {
  id          String   @id @default(cuid())
  mentorId    String
  mentor      UserProfile @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId    String
  mentee      UserProfile @relation("MentorshipMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  message     String?
  goals       String?  // JSON: [{ goal, timeline }]
  status      String   @default("pending") // pending | accepted | declined
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mentorId, status])
  @@index([menteeId])
}

model MentorshipSession {
  id          String   @id @default(cuid())
  requestId   String?
  mentorId    String
  menteeId    String
  title       String?
  notes       String?
  scheduledAt DateTime?
  completedAt DateTime?
  feedback    String?  // JSON: { rating, comments, goalsProgress }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([mentorId])
  @@index([menteeId])
}
